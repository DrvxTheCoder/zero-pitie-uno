# SQLite file (relative to the project root)
DATABASE_URL="file:./data/zeropitie.db"

# Back-office account created by `npm run db:seed`
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-please"

# Set to "false" so only the back office can create leagues
ALLOW_SIGNUP="true"

# Force Secure cookies (auto-detected behind a proxy sending X-Forwarded-Proto: https)
COOKIE_SECURE="false"
